# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env is gitignored, so real passwords never get committed. This example file IS committed,
# so everyone knows which variables exist.
#
# Who reads .env:
#   - Docker Compose, automatically: for ${...} in compose.dev.yml, and passed into the app
#     container through `env_file:`
#   - the app, when run from IntelliJ or ./gradlew bootRun, through spring.config.import in
#     grails-app/conf/application.yml
#
# Format: KEY=value, one per line, no spaces around "=", no quotes. Both Compose and Spring's
# .properties parser read that the same way.

# Postgres. The compose file creates the database and user from these on first start.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storage
DB_USERNAME=storage
DB_PASSWORD=change-me
